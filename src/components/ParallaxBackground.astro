---
// Fundal cinematografic Luxury Parallax cu scalare optică Zoom In / Out la scroll.
// Zero dependențe externe, accelerat pe GPU prin transform3d și will-change.
---

<div id="parallax-bg-layer" class="parallax-bg-layer" aria-hidden="true">
  <div id="parallax-bg-image" class="parallax-bg-image"></div>
  <div class="parallax-bg-overlay"></div>
</div>

<script>
  (() => {
    const bg = document.getElementById('parallax-bg-image');
    if (!bg) return;

    // WCAG 2.2: Respectă opțiunea utilizatorului de a reduce mișcarea
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      bg.style.transform = 'scale(1.05)';
      return;
    }

    let ticking = false;

    const updateZoom = () => {
      const scrollY = window.scrollY || window.pageYOffset;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      if (docHeight <= 0) return;

      const progress = Math.min(1, Math.max(0, scrollY / docHeight));

      // Curba organică de zoom:
      // - Început (Hero sus): scale(1.00)
      // - Mijloc (Catalog de produse): zoom in fluid până la scale(1.22)
      // - Final (Locații & Footer): zoom out lin spre scale(1.08)
      const scale = 1.0 + Math.sin(progress * Math.PI) * 0.22 + progress * 0.04;
      bg.style.transform = `scale3d(${scale.toFixed(4)}, ${scale.toFixed(4)}, 1)`;
      ticking = false;
    };

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          window.requestAnimationFrame(updateZoom);
          ticking = true;
        }
      },
      { passive: true }
    );

    // Inițializare imediată
    updateZoom();
  })();
</script>

<style>
  .parallax-bg-layer {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .parallax-bg-image {
    position: absolute;
    inset: -6%;
    width: 112%;
    height: 112%;
    background-image: url('/images/tulip_hero.webp');
    background-size: cover;
    background-position: center 32%;
    background-repeat: no-repeat;
    transform: scale3d(1, 1, 1);
    will-change: transform;
    transform-origin: center center;
    filter: saturate(1.08) contrast(1.02);
  }

  /* Overlay de mătase ivoire cu estompare radială:
     garantează contrastul WCAG AA (textul rămâne lizibil oriunde pe ecran) */
  .parallax-bg-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse at 50% 35%,
      rgba(251, 248, 243, 0.58) 0%,
      rgba(251, 248, 243, 0.78) 55%,
      rgba(251, 248, 243, 0.94) 100%
    );
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
  }

  /* Pe mobil: reutilizează imaginea compactă hero și întărește voalul crem-ivoire
     ca textul Hero centrat (verde închis & auriu) să rămână foarte clar */
  @media (max-width: 767px) {
    .parallax-bg-image {
      background-image: url('/images/tulip_hero-mobile.webp');
      background-position: center 28%;
    }

    .parallax-bg-overlay {
      background: radial-gradient(
        ellipse at 50% 30%,
        rgba(251, 248, 243, 0.78) 0%,
        rgba(251, 248, 243, 0.86) 55%,
        rgba(251, 248, 243, 0.95) 100%
      );
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
    }
  }
</style>
