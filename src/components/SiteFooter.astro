<script is:inline>
  document.getElementById('footer-reset-cookies')?.addEventListener('click', (e) => {
    e.preventDefault();
    try {
      localStorage.removeItem('siati_gdpr_consent');
      localStorage.removeItem('siati_gdpr_consent_v1');
      const banner = document.getElementById('gdpr-consent-banner');
      if (banner) {
        banner.hidden = false;
        banner.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } else {
        window.location.href = '/politica-cookies';
      }
    } catch (_) {
      window.location.href = '/politica-cookies';
    }
  });

  // Gestionare Abonare Newsletter Footer
  const newsletterForm = document.getElementById('footer-newsletter-form');
  const newsletterInput = document.getElementById('footer-newsletter-email');
  const newsletterSubmit = document.getElementById('footer-newsletter-submit');
  const newsletterFeedback = document.getElementById('footer-newsletter-feedback');

  newsletterForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (
      !(newsletterInput instanceof HTMLInputElement) ||
      !(newsletterSubmit instanceof HTMLButtonElement) ||
      !(newsletterFeedback instanceof HTMLElement)
    ) {
      return;
    }
    const email = newsletterInput.value.trim();
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!email || !emailRegex.test(email)) {
      newsletterFeedback.hidden = false;
      newsletterFeedback.textContent = 'Te rugăm să introduci o adresă de email validă.';
      newsletterFeedback.className = 'newsletter-feedback newsletter-feedback--error';
      newsletterInput.focus();
      return;
    }

    newsletterSubmit.disabled = true;
    newsletterSubmit.textContent = 'Se trimite...';
    newsletterFeedback.hidden = true;

    try {
      const res = await fetch('/api/newsletter/subscribe', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Accept: 'application/json',
        },
        body: JSON.stringify({ email, source: 'footer' }),
      });
      const data = await res.json().catch(() => ({}));
      if (res.ok && data.success) {
        newsletterFeedback.hidden = false;
        newsletterFeedback.textContent =
          '✨ Mulțumim! Te-ai abonat cu succes la Oferta Săptămânii și recomandările atelierului.';
        newsletterFeedback.className = 'newsletter-feedback newsletter-feedback--success';
        newsletterInput.value = '';
        newsletterSubmit.disabled = false;
        newsletterSubmit.textContent = 'Abonat!';
      } else {
        newsletterFeedback.hidden = false;
        newsletterFeedback.textContent =
          data.message || 'A apărut o eroare la salvarea adresei. Te rugăm să reîncerci.';
        newsletterFeedback.className = 'newsletter-feedback newsletter-feedback--error';
        newsletterSubmit.disabled = false;
        newsletterSubmit.textContent = 'Mă Abonez';
      }
    } catch (_) {
      newsletterFeedback.hidden = false;
      newsletterFeedback.textContent = 'Conexiunea cu serverul a eșuat. Te rugăm să reîncerci.';
      newsletterFeedback.className = 'newsletter-feedback newsletter-feedback--error';
      newsletterSubmit.disabled = false;
      newsletterSubmit.textContent = 'Mă Abonez';
    }
  });
</script>

