---
import { getShopStatus } from '../lib/shop-status';

// Starea atelierului la momentul cererii (ora din București); în browser se actualizează la fiecare minut.
const shopStatus = getShopStatus();
---

<!-- SECȚIUNEA 1: Grand Editorial Hero — Atelier Parizian Floral de Lux -->
<section id="scrolly-hero" class="editorial-hero" aria-label="Atelier Floral Siati Ploiești & Blejoi">
  <div class="container hero-container">
    <div class="hero-split-grid">
      <!-- Coloana Text & Narativ Editorial -->
      <div class="hero-content" id="hero-floating-content">
        <div class="hero-eyebrow-wrapper">
          <span class="hero-eyebrow-pill">Atelier & Tradiție • Din 2003 în Ploiești</span>
          <span class="hero-live-badge" data-shop-status data-phase={shopStatus.phase}>
            <span class="pulse-emerald" aria-hidden="true"></span>
            <span data-shop-status-label>{shopStatus.label}</span>
          </span>
        </div>

        <h1 class="hero-editorial-title">
          Flori cu suflet în fiecare <em>petală</em>.
        </h1>

        <p class="hero-editorial-lead">
          Creat sub îndrumarea maestrului floral <strong>Ileana Militaru</strong>, fondatoarea <em>Școlii de Flori</em>. Cu peste 20 de ani de măiestrie, aducem flori de licitație <strong>Hilverda De Boer (Olanda)</strong> hidratate la 4°C în atelierele noastre din <strong>Galeria Carrefour Ploiești</strong> și livrate impecabil în tot județul Prahova.
        </p>

        <!-- Puncte Cheie de Încredere & Reputație Reale -->
        <div class="hero-trust-list">
          <div class="trust-item">
            <span class="trust-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
            </span>
            <div class="trust-text">
              <strong>Poză reală pe WhatsApp</strong>
              <span>Aprobare înainte de plecarea livratorului</span>
            </div>
          </div>

          <div class="trust-item">
            <span class="trust-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            </span>
            <div class="trust-text">
              <strong>Livrare atentă în 2–3 ore</strong>
              <span>Flotă proprie în Ploiești, Blejoi, Valea Prahovei</span>
            </div>
          </div>

          <div class="trust-item">
            <span class="trust-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path></svg>
            </span>
            <div class="trust-text">
              <strong>Partener Festivalul „Toma Caragiu”</strong>
              <span>Instalații scenice & excelență florală recunoscută</span>
            </div>
          </div>
        </div>

        <!-- Butoane Principale CTA -->
        <div class="hero-actions">
          <a href="#colectii" class="btn-primary hero-btn-main">
            <span>Explorează Colecțiile</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a
            href="https://wa.me/40723852820?text=Bun%C4%83%20ziua!%20A%C8%99%20dori%20s%C4%83%20comand%20flori%20de%20la%20Flor%C4%83ria%20Siati."
            target="_blank"
            rel="noopener noreferrer"
            class="btn-secondary hero-btn-whatsapp"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.669-.699c.969.58 1.942.88 2.791.88 3.18 0 5.767-2.587 5.767-5.766.001-3.181-2.585-5.766-5.767-5.766zm3.391 8.192c-.145.409-.848.781-1.183.829-.315.045-.71.07-2.072-.493-1.638-.677-2.695-2.348-2.776-2.457-.082-.109-.661-.88-.661-1.677 0-.797.416-1.189.564-1.352.148-.163.324-.204.433-.204.108 0 .217.001.312.006.1.005.234-.038.366.279.136.327.464 1.134.505 1.216.041.082.069.177.014.286-.054.109-.082.177-.163.272-.082.095-.172.213-.246.286-.082.082-.168.172-.072.336.095.163.424.7 1.037 1.246.791.704 1.458.922 1.666 1.025.209.103.33.09.453-.05.123-.14.526-.613.666-.823.14-.21.28-.175.472-.104.192.071 1.218.574 1.428.679.21.105.35.157.401.245.051.088.051.51-.094.919z"/></svg>
            <span>Consultă Floristul pe WhatsApp</span>
          </a>
        </div>
      </div>

      <!-- Coloana Vizuală: Vitrină Florală Editorială (LCP Primar) -->
      <div class="hero-visual">
        <div class="hero-frame">
          <picture>
            <source srcset="/images/tulip_hero.webp" media="(min-width: 768px)" type="image/webp" />
            <source srcset="/images/tulip_hero-mobile.webp" type="image/webp" />
            <img
              src="/images/tulip_hero.webp"
              alt="Buchetul Semnătură Siati — Lalele Albe Olandeze și Eucalipt Proaspăt"
              class="hero-img"
              width="800"
              height="1000"
              fetchpriority="high"
              decoding="async"
            />
          </picture>

          <!-- Badges Suprapuse Peste Cadru -->
          <div class="hero-floating-card hero-floating-card--top">
            <span class="card-gold-star">★ 4.9</span>
            <span>Apreciat de mii de clienți în Prahova • Tradiție din 2003</span>
          </div>

          <div class="hero-floating-card hero-floating-card--bottom">
            <div class="florist-stamp">
              <span class="stamp-icon">🎓</span>
              <div>
                <strong>Atelier & Școala de Flori</strong>
                <small>Bursa Hilverda De Boer (Olanda)</small>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Păstrează insignele de program corecte după încărcarea paginii (rulează o singură dată pe pagină).
  import '../scripts/shop-status-client';
</script>

<style>
  .editorial-hero {
    position: relative;
    padding: 7.5rem 0 4.5rem;
    background: radial-gradient(circle at 85% 20%, rgba(201, 166, 107, 0.08) 0%, transparent 50%),
                radial-gradient(circle at 10% 80%, rgba(142, 27, 45, 0.04) 0%, transparent 45%);
    overflow: hidden;
  }

  .hero-container {
    max-width: 1240px;
  }

  .hero-split-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.95fr;
    gap: 3.5rem;
    align-items: center;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hero-eyebrow-wrapper {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.35rem;
  }

  .hero-eyebrow-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.35rem 0.85rem;
    background: rgba(142, 27, 45, 0.08);
    color: var(--brand-red);
    border: 1px solid rgba(142, 27, 45, 0.18);
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .hero-live-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.85rem;
    background: rgba(21, 50, 38, 0.06);
    color: var(--eucalyptus-dark);
    border: 1px solid rgba(21, 50, 38, 0.12);
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 600;
  }

  .pulse-emerald {
    flex-shrink: 0;
    width: 8px;
    height: 8px;
    background: #10b981;
    border-radius: 50%;
    box-shadow: 0 0 8px rgba(16, 185, 129, 0.8);
    animation: pulseGlow 2s infinite ease-in-out;
  }

  /* Starea atelierului: textul vine din src/lib/shop-status.ts, culoarea punctului din data-phase */
  .hero-live-badge {
    max-width: 100%;
    line-height: 1.35;
  }

  .hero-live-badge[data-phase='evening'] .pulse-emerald {
    background: var(--gold-warm);
    box-shadow: 0 0 8px rgba(184, 142, 68, 0.7);
  }

  .hero-live-badge[data-phase='closed'] .pulse-emerald {
    background: var(--text-muted);
    box-shadow: none;
    animation: none;
  }

  @keyframes pulseGlow {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.4;
      transform: scale(0.85);
    }
  }

  .hero-editorial-title {
    font-family: var(--font-serif);
    font-size: clamp(2.8rem, 5.2vw, 4.5rem);
    font-weight: 600;
    line-height: 1.1;
    color: var(--eucalyptus-dark);
    letter-spacing: -0.015em;
    margin-bottom: 1.35rem;
  }

  .hero-editorial-title em {
    font-style: italic;
    font-family: var(--font-serif);
    font-weight: 600;
    color: var(--gold-warm);
    background: linear-gradient(135deg, #b88e44 0%, #d4af37 45%, #a6782a 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-editorial-lead {
    font-size: clamp(1.05rem, 1.8vw, 1.2rem);
    line-height: 1.7;
    color: var(--text-muted);
    margin-bottom: 2rem;
    max-width: 580px;
  }

  .hero-editorial-lead strong {
    color: var(--eucalyptus-dark);
    font-weight: 600;
  }

  .hero-trust-list {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    margin-bottom: 2.25rem;
    width: 100%;
    max-width: 540px;
  }

  .trust-item {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    padding: 0.65rem 0.95rem;
    background: rgba(255, 255, 255, 0.78);
    border: 1px solid rgba(197, 160, 89, 0.22);
    border-radius: var(--radius-sm);
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .trust-item:hover {
    background: #ffffff;
  }

  .trust-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(21, 50, 38, 0.08);
    color: var(--eucalyptus-dark);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .trust-text {
    display: flex;
    flex-direction: column;
  }

  .trust-text strong {
    font-size: 0.92rem;
    color: var(--eucalyptus-dark);
  }

  .trust-text span {
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
  }

  .hero-btn-main {
    padding: 1rem 2rem;
    font-size: 1.02rem;
    box-shadow: 0 10px 24px -6px rgba(21, 50, 38, 0.35);
  }

  .hero-btn-whatsapp {
    padding: 0.95rem 1.6rem;
    background: #ffffff;
    border: 1.5px solid rgba(21, 50, 38, 0.25);
  }

  .hero-btn-whatsapp:hover {
    background: var(--eucalyptus-dark);
    color: #ffffff;
  }

  /* Vitrina Vizuală a Eroului */
  .hero-visual {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .hero-frame {
    position: relative;
    width: 100%;
    max-width: 480px;
    border-radius: 36px;
    overflow: hidden;
    background: #ffffff;
    box-shadow: 0 32px 70px -16px rgba(27, 59, 43, 0.14),
                0 0 0 1px rgba(197, 160, 89, 0.24);
  }

  .hero-img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero-frame:hover .hero-img {
    transform: scale(1.03);
  }

  .hero-floating-card {
    position: absolute;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(197, 160, 89, 0.28);
    box-shadow: 0 16px 36px -8px rgba(0, 0, 0, 0.12);
    border-radius: 999px;
    padding: 0.55rem 1.15rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--eucalyptus-dark);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    pointer-events: none;
  }

  .hero-floating-card--top {
    top: 1.5rem;
    right: 1.5rem;
  }

  .hero-floating-card--bottom {
    bottom: 1.5rem;
    left: 1.5rem;
    border-radius: var(--radius-md);
    padding: 0.65rem 1rem;
  }

  .card-gold-star {
    color: #d4af37;
    font-weight: 700;
    font-size: 0.9rem;
  }

  .florist-stamp {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .stamp-icon {
    font-size: 1.25rem;
  }

  .florist-stamp div {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }

  .florist-stamp strong {
    font-size: 0.85rem;
    color: var(--eucalyptus-dark);
  }

  .florist-stamp small {
    font-size: 0.74rem;
    color: var(--text-muted);
  }

  @media (max-width: 980px) {
    .editorial-hero {
      padding: 5.5rem 0 2.5rem;
    }

    .hero-split-grid {
      display: flex;
      flex-direction: column;
      gap: 0;
    }

    .hero-content {
      display: contents;
    }

    .hero-eyebrow-wrapper {
      order: 1;
      display: flex;
      justify-content: center;
      margin-bottom: 0.65rem;
      gap: 0.5rem;
    }

    .hero-editorial-title {
      order: 2;
      text-align: center;
      font-size: clamp(2.1rem, 7vw, 2.85rem);
      line-height: 1.15;
      margin-bottom: 1rem;
    }

    .hero-visual {
      order: 3;
      margin: 0.25rem auto 1.35rem;
      width: 100%;
      max-width: 320px;
    }

    .hero-editorial-lead {
      order: 4;
      text-align: center;
      font-size: 0.95rem;
      line-height: 1.6;
      margin: 0 auto 1.35rem;
      max-width: 440px;
      padding: 0 0.5rem;
    }

    .hero-actions {
      order: 5;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.65rem;
      width: 100%;
      max-width: 340px;
      margin: 0 auto 1.75rem;
    }

    .hero-actions a {
      width: 100%;
      justify-content: center;
      min-height: 48px;
      font-size: 0.92rem;
    }

    .hero-trust-list {
      order: 6;
      display: flex;
      flex-direction: row;
      flex-wrap: nowrap;
      overflow-x: auto;
      gap: 0.65rem;
      width: 100%;
      padding: 0.25rem 0.75rem 0.75rem;
      margin: 0 auto;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      justify-content: flex-start;
    }

    .hero-trust-list::-webkit-scrollbar {
      display: none;
    }

    .trust-item {
      flex: 0 0 auto;
      background: rgba(255, 255, 255, 0.92);
      border: 1px solid rgba(197, 160, 89, 0.22);
      border-radius: 999px;
      padding: 0.45rem 0.85rem;
      gap: 0.45rem;
      box-shadow: 0 2px 8px rgba(46, 34, 30, 0.04);
    }

    .trust-text span {
      display: none;
    }

    .trust-text strong {
      font-size: 0.8rem;
      white-space: nowrap;
    }

    .hero-frame {
      max-width: 320px;
      border-radius: 24px;
    }
  }

  @media (max-width: 640px) {
    .editorial-hero {
      padding: 4.8rem 0 2rem;
    }

    .hero-floating-card--top {
      top: 0.75rem;
      right: 0.75rem;
      font-size: 0.72rem;
      padding: 0.35rem 0.75rem;
    }

    .hero-floating-card--bottom {
      bottom: 0.75rem;
      left: 0.75rem;
      padding: 0.45rem 0.75rem;
    }
  }
</style>
