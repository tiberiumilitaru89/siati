---
export interface Props {
  phone?: string;
  defaultMessage?: string;
}

const {
  phone = '40723852820',
  defaultMessage = 'Bună ziua! Vă contactez de pe site-ul Florăria Siati. Doresc recomandarea unui buchet de flori proaspete cu livrare în Ploiești / Prahova.',
} = Astro.props;

const whatsappUrl = `https://wa.me/${phone}?text=${encodeURIComponent(defaultMessage)}`;
---

<aside
  id="floating-whatsapp-widget"
  class="floating-whatsapp"
  aria-label="Asistență rapidă WhatsApp Florăria Siati"
>
  <!-- Tooltip discret pentru clienți -->
  <div id="whatsapp-tooltip" class="floating-whatsapp__tooltip">
    <button
      type="button"
      id="close-whatsapp-tooltip"
      class="tooltip-close-btn"
      aria-label="Închide sugestia WhatsApp"
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </button>
    <div class="tooltip-content">
      <div class="tooltip-icon" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path><circle cx="12" cy="13" r="4"></circle></svg>
      </div>
      <div class="tooltip-text">
        <strong>Vrei poză înainte de livrare?</strong>
        <p>Scrie-ne pe WhatsApp și îți trimitem poza buchetului real din atelier!</p>
      </div>
    </div>
  </div>

  <!-- Butonul Plutitor WhatsApp cu Halo Pulsant -->
  <a
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="floating-whatsapp__btn"
    aria-label="Discută pe WhatsApp cu Florăria Siati (0723 852 820)"
  >
    <span class="pulsing-halo" aria-hidden="true"></span>
    <svg class="whatsapp-icon" width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.335-1.662c1.746.953 3.71 1.456 5.711 1.457h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
    </svg>
    <span class="btn-label">WhatsApp Siati</span>
  </a>
</aside>

<script is:inline>
  (() => {
    if (window.location.pathname.startsWith('/admin')) {
      const widget = document.getElementById('floating-whatsapp-widget');
      if (widget) widget.style.display = 'none';
      return;
    }

    const storageKey = 'siati_wa_tooltip_dismissed';
    const tooltip = document.getElementById('whatsapp-tooltip');
    const closeBtn = document.getElementById('close-whatsapp-tooltip');

    if (tooltip && window.localStorage.getItem(storageKey) === 'true') {
      tooltip.style.display = 'none';
    }

    if (closeBtn && tooltip) {
      closeBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        e.preventDefault();
        tooltip.style.display = 'none';
        try {
          window.localStorage.setItem(storageKey, 'true');
        } catch (_) {}
      });

      // Se estompează automat după 7 secunde pentru o experiență discretă pe mobil
      setTimeout(() => {
        if (tooltip && tooltip.style.display !== 'none') {
          tooltip.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
          tooltip.style.opacity = '0';
          tooltip.style.transform = 'translateY(8px)';
          tooltip.style.pointerEvents = 'none';
          setTimeout(() => {
            tooltip.style.display = 'none';
          }, 450);
        }
      }, 7000);
    }
  })();
</script>

<style>
  .floating-whatsapp {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    z-index: 920;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    pointer-events: auto;
  }

  .floating-whatsapp__tooltip {
    position: relative;
    margin-bottom: 0.75rem;
    max-width: 260px;
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(37, 211, 102, 0.35);
    border-radius: 16px;
    padding: 0.85rem 1rem;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.15);
    animation: tooltip-fade 0.3s ease;
  }

  .tooltip-close-btn {
    position: absolute;
    top: 0.4rem;
    right: 0.4rem;
    width: 22px;
    height: 22px;
    border: none;
    background: transparent;
    color: #888;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
  }

  .tooltip-close-btn:hover {
    color: #111;
    background: rgba(0, 0, 0, 0.05);
  }

  .tooltip-content {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    padding-right: 0.5rem;
  }

  .tooltip-icon {
    color: #1b6d48;
    flex-shrink: 0;
    margin-top: 0.15rem;
  }

  .tooltip-text strong {
    display: block;
    font-size: 0.82rem;
    color: #153226;
    margin-bottom: 0.2rem;
  }

  .tooltip-text p {
    font-size: 0.74rem;
    color: #4e5a54;
    line-height: 1.35;
    margin: 0;
  }

  .floating-whatsapp__btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    background: #25d366;
    color: #ffffff;
    padding: 0.85rem 1.4rem;
    border-radius: 999px;
    box-shadow: 0 10px 25px rgba(37, 211, 102, 0.45);
    text-decoration: none;
    font-weight: 700;
    font-size: 0.92rem;
    transition: transform 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
    cursor: pointer;
  }

  .floating-whatsapp__btn:hover {
    background: #20ba59;
    transform: translateY(-2px) scale(1.03);
    box-shadow: 0 14px 30px rgba(37, 211, 102, 0.55);
  }

  .pulsing-halo {
    position: absolute;
    inset: -3px;
    border-radius: 999px;
    background: rgba(37, 211, 102, 0.45);
    animation: halo-ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;
    pointer-events: none;
    z-index: -1;
  }

  @keyframes halo-ping {
    0% {
      transform: scale(0.95);
      opacity: 0.8;
    }
    70%, 100% {
      transform: scale(1.35);
      opacity: 0;
    }
  }

  @keyframes tooltip-fade {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 768px) {
    .floating-whatsapp {
      bottom: calc(1.25rem + env(safe-area-inset-bottom, 0));
      right: 1.25rem;
    }

    .floating-whatsapp__tooltip {
      max-width: 230px;
      padding: 0.75rem 0.85rem;
    }

    .floating-whatsapp__btn {
      padding: 0.8rem;
      border-radius: 50%;
      width: 54px;
      height: 54px;
      justify-content: center;
    }

    .btn-label {
      display: none;
    }
  }
</style>
