---
import type { WeeklyOffer } from '../lib/supabase';

export interface Props {
  weeklyOffer?: WeeklyOffer | null;
  /**
   * Destinația linkului „Comandă Online”. Pe prima pagină checkout-ul nu mai există (comenzile se fac pe
   * /produs/[slug]), deci linkul duce la colecții; paginile de produs îl trimit la propriul checkout.
   */
  orderHref?: string;
}

const { weeklyOffer, orderHref = '/#colectii' } = Astro.props;
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/#scrolly-hero" class="brand-logo" aria-label="Florăria Siati - Pagina principală">
      <span class="brand-logo__emblem" aria-hidden="true">
        <svg width="34" height="34" viewBox="0 0 40 40" fill="none">
          <path d="M20 5C13 11 9 17 11 25C12.5 31 18 35 20 35C20 35 17 28 18 20C18.8 13.5 20 5 20 5Z" fill="#8e1b2d" />
          <path d="M20 5C23 10 28 14 27 22C26 28 21.5 34 20 35C20 35 22 26 21 19C20.3 14 20 5 20 5Z" fill="#a8283d" />
          <path d="M20 19C26 18 33 21 34 27C34.8 32 30 36 26 36C20 36 20 19 20 19Z" fill="#153226" />
          <path d="M20 21C15 21 8 25 7 31C6.2 36 11 38 16 37C20 36 20 21 20 21Z" fill="#1f4534" />
          <circle cx="20" cy="20" r="2.5" fill="#d4af37" />
        </svg>
      </span>
      <span class="brand-logo__text">
        <span class="brand-logo__title"><span class="brand-title--red">SIA</span><span class="brand-title--green">TI</span></span>
        <span class="brand-logo__subtitle">Flori cu Suflet • Din 2003</span>
      </span>
    </a>

    <nav class="main-nav" aria-label="Navigare principală">
      <a href="/#colectii">Colecții Florale</a>
      {weeklyOffer && <a href="/#oferta-saptamanii">Oferta Săptămânii</a>}
      <a href="/#buget-whatsapp">Comandă pe Buget</a>
      <a href={orderHref}>Comandă Online</a>
      <a href="/#scoala-de-flori">Școala de Flori</a>
      <a href="/#locatii">Locații & Program</a>
      <a href="/#recenzii">Recenzii</a>
    </nav>

    <div class="header-cta">
      {
        weeklyOffer && (
          <button
            type="button"
            id="open-weekly-offer-btn"
            class="btn-rose btn-sm"
            aria-haspopup="dialog"
            aria-controls="weekly-offer-dialog"
          >
            Oferta Săptămânii
          </button>
        )
      }
      <a href="tel:+40723852820" class="btn-secondary btn-sm header-tel-btn">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
        <span>0723 852 820</span>
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 900;
    background: rgba(250, 247, 242, 0.92);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--border-subtle);
    transition: background-color 0.25s ease;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 72px;
    gap: 1rem;
  }

  .brand-logo {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
  }

  .brand-logo__emblem {
    display: flex;
    align-items: center;
    justify-content: center;
    filter: drop-shadow(0 4px 8px rgba(21, 50, 38, 0.15));
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .brand-logo:hover .brand-logo__emblem {
    transform: scale(1.1) rotate(-4deg);
  }

  .brand-logo__text {
    display: flex;
    flex-direction: column;
  }

  .brand-logo__title {
    font-family: var(--font-serif);
    font-size: 1.55rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    line-height: 1;
  }

  .brand-title--red {
    color: var(--brand-red);
  }

  .brand-title--green {
    color: var(--eucalyptus-dark);
  }

  .brand-logo__subtitle {
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    margin-top: 0.2rem;
  }

  .main-nav {
    display: flex;
    gap: 1.4rem;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .main-nav a {
    transition: color 0.15s ease;
  }

  .main-nav a:hover {
    color: var(--dusty-rose);
  }

  .header-cta {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .header-tel-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  @media (max-width: 820px) {
    .main-nav {
      display: none;
    }
    .header-tel-btn span {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .header-inner {
      min-height: 60px;
    }
    .brand-logo__subtitle {
      display: none;
    }
    #open-weekly-offer-btn {
      min-height: 40px;
      padding: 0.45rem 0.85rem;
      font-size: 0.8rem;
    }
    .header-tel-btn {
      width: 44px;
      height: 44px;
      padding: 0;
      justify-content: center;
      border-radius: 50%;
    }
  }
</style>
