# ============================================================================
# Variabile de mediu — Florăria Siati
# Local: copiază în `.env`. Producție: Cloudflare Pages → Settings → Variables and Secrets
# (tipul „Secret” pentru toate cheile). Nu publica NICIODATĂ valori reale în repository.
#
# Notă Cloudflare: variabilele devin vizibile în cod prin `process.env` datorită flag-ului
# `nodejs_compat_populate_process_env` din wrangler.json.
# ============================================================================

# Supabase Configuration
PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe Configuration
STRIPE_SECRET_KEY=sk_live_or_test_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# SmartBill RO e-Factura (SPV) Configuration
# SMARTBILL_EMAIL = emailul contului SmartBill (este utilizatorul pentru API) — OBLIGATORIU pentru facturare
SMARTBILL_EMAIL=contact@floraria-siati.ro
SMARTBILL_API_TOKEN=your_smartbill_api_token
SMARTBILL_CIF=RO15942693
# Alias acceptat: SMARTBILL_SERIES
SMARTBILL_INVOICE_SERIES=SIATI

# Transactional Notifications & Automated Reports (Resend & WhatsApp)
RESEND_API_KEY=re_your_resend_key
RESEND_FROM_EMAIL=Florăria Siati <contact@floraria-siati.ro>
REPORT_RECIPIENT_EMAIL=contact@floraria-siati.ro
# Alias acceptat: WHATSAPP_WEBHOOK_URL
WHATSAPP_GROUP_WEBHOOK_URL=https://your-whatsapp-webhook-endpoint
# Minimum 24 de caractere, aleatoriu. Valorile de tip „replace-with…” sunt ignorate de cod.
CRON_SECRET=replace-with-strong-cron-bearer-secret

# Analytics & Heatmaps (GDPR Consent Gated)
PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
PUBLIC_CLARITY_PROJECT_ID=xxxxxxxxxx

# In-Site Admin Panel (/admin) Security — OBLIGATORII
# Fără valori valide, /admin rămâne blocat (nu există parolă implicită).
#   ADMIN_PANEL_PASSWORD  : minimum 12 caractere
#   ADMIN_SESSION_SECRET  : minimum 32 de caractere aleatorii, diferit de parolă
# Generare (PowerShell):  [Convert]::ToBase64String((1..48 | % { Get-Random -Maximum 256 }) -as [byte[]])
ADMIN_PANEL_PASSWORD=replace-with-a-long-unique-password
ADMIN_SESSION_SECRET=replace-with-strong-32-byte-hmac-secret
